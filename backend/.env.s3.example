# REG.RU S3 settings for Fluxora Backend
S3_ENDPOINT=https://s3.regru.cloud
S3_BUCKET=fluxora.su
# TEMPORARY signing region. Replace with the exact value confirmed by REG.RU.
S3_REGION=us-east-1
# Keep credentials only in the server-side environment. Never commit real values.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional SMTP settings for email change confirmation
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
